{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/socket-io(/.*)?", "destination": "/api/socket-io" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/socket-io.ts": { "maxDuration": 300 }
  }
}
